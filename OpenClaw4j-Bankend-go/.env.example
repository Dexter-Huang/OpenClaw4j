# Go 后端本地开发配置。复制为 .env 后按本机环境填写，.env 不会被提交。

# PostgreSQL（必填）
OPENCLAW_DATABASE_DSN=postgres://postgres:password@127.0.0.1:5432/openclaw?sslmode=disable

# Redis
OPENCLAW_REDIS_HOST=127.0.0.1
OPENCLAW_REDIS_PORT=6379
OPENCLAW_REDIS_PASSWORD=
OPENCLAW_REDIS_DATABASE=0

# HTTP 服务
OPENCLAW_HTTP_ADDR=:9004

# 文件与脚本沙箱
OPENCLAW_FILE_STORAGE_DIR=data/files
OPENCLAW_SANDBOX_BASE_URL=http://127.0.0.1:9010
OPENCLAW_SANDBOX_TIMEOUT_MS=30000

# GitHub OAuth（按需填写）
OPENCLAW_GITHUB_CLIENT_ID=
OPENCLAW_GITHUB_CLIENT_SECRET=
OPENCLAW_GITHUB_REDIRECT_URI=
