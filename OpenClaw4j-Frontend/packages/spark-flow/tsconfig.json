{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react",
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@@/*": ["./.dumi/tmp/*"],
      "@/*": ["./src/*"],
      "@spark-flow/*": ["./src/*"],
      "@spark-ai/flow": ["./src"],
      "@spark-ai/flow/*": ["./src/*", "./*"]
    }
  },
  "include": [".dumirc.ts", "src/**/*"]
}
