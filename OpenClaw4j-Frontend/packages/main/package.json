{
  "name": "main",
  "version": "0.0.1",
  "scripts": {
    "prebuild": "npm run tailwind:build",
    "build": "cross-env DID_YOU_KNOW=none umi build",
    "predev": "npm run tailwind:build",
    "dev": "cross-env DID_YOU_KNOW=none CHECK_TIMEOUT=30 umi dev",
    "dev:clean": "rimraf src/.umi src/.umi-production src/.umi-test node_modules/.cache && npm run dev",
    "dev:flow": "cross-env FLOW_DEV=true DID_YOU_KNOW=none CHECK_TIMEOUT=30 umi dev",
    "postinstall": "umi setup",
    "setup": "umi setup",
    "start": "npm run dev",
    "tailwind:build": "tailwindcss -c ./tailwind.config.js -i ./tailwind.css -o ./src/.tailwind/tailwind.css"
  },
  "dependencies": {
    "@ant-design/icons": "^5",
    "@codemirror/lang-json": "^6.0.2",
    "@spark-ai/chat": "^1.1.4",
    "@spark-ai/flow": "0.0.13",
    "@uiw/codemirror-theme-github": "^4.23.10",
    "@uiw/react-codemirror": "^4.25.1",
    "ahooks": "3.8.1",
    "antd": "^5",
    "classnames": "^2.5.1",
    "copy-to-clipboard": "^3.3.3",
    "dayjs": "^1.11.13",
    "diff2html": "^3.4.52",
    "eventemitter3": "^5.0.1",
    "react-error-boundary": "^6.0.0",
    "react-json-view": "^1.21.3",
    "react-resizable-panels": "^0.0.63",
    "react-router-dom": "^6.30.4",
    "umi": "^4.6.70",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.11",
    "@umijs/plugins": "^4.6.70",
    "tailwindcss": "^3",
    "typescript": "^5.0.3"
  }
}
