POSTGRES_DB=openclaw4j
POSTGRES_USER=openclaw
POSTGRES_PASSWORD=openclaw
POSTGRES_PORT=5432

REDIS_PORT=6379

AIO_SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
AIO_SANDBOX_PORT=8080
AIO_SANDBOX_WORKSPACE=/home/gem
AIO_SANDBOX_TZ=Asia/Shanghai
AIO_SANDBOX_MEMORY_LIMIT=2g
AIO_SANDBOX_MEMORY_SWAP_LIMIT=2g
AIO_SANDBOX_PIDS_LIMIT=512
# AIO_SANDBOX_API_KEY=
# AIO_SANDBOX_SHM_SIZE=2gb

OPENCLAW_SANDBOX_IMAGE=openclaw4j-sandbox:local
OPENCLAW_SANDBOX_PORT=9010
OPENCLAW_SANDBOX_DEFAULT_TIMEOUT_MS=30000
OPENCLAW_SANDBOX_MAX_TIMEOUT_MS=120000
OPENCLAW_SANDBOX_MEMORY_LIMIT=512M
OPENCLAW_SANDBOX_PROCESS_LIMIT=16
OPENCLAW_SANDBOX_DEPS_DIR=/opt/openclaw4j-sandbox/deps
OPENCLAW_SANDBOX_PYTHON_RUNTIME=/opt/openclaw4j-sandbox/deps/python/bin/python
OPENCLAW_SANDBOX_NODE_PATH=/opt/openclaw4j-sandbox/deps/node/node_modules
OPENCLAW_SANDBOX_RUST_LOG=openclaw4j_sandbox=info,tower_http=info
OPENCLAW_SANDBOX_TZ=Asia/Shanghai

# Redis Sentinel 拓扑已默认关闭；如需恢复哨兵机制，再取消下面配置的注释。
# REDIS_MASTER_PORT=6379
# REDIS_REPLICA_1_PORT=6380
# REDIS_REPLICA_2_PORT=6381
# REDIS_SENTINEL_1_PORT=26379
# REDIS_SENTINEL_2_PORT=26380
# REDIS_SENTINEL_3_PORT=26381
